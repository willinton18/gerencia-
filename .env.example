# ─────────────────────────────────────────────────────────────
# Variables de entorno - ST Soluciones Tecnológicas (Mesa de Ayuda)
# Copia este archivo a ".env.local" y rellena los valores reales.
# ─────────────────────────────────────────────────────────────

# Cadena de conexión de MongoDB.
# Opción A (local con Docker / mongod):  mongodb://localhost:27017/st-soluciones
# Opción B (MongoDB Atlas, gratis):      mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/st-soluciones
MONGODB_URI=mongodb://localhost:27017/st-soluciones

# Secreto para firmar los JWT de sesión. Usa una cadena larga y aleatoria.
# Puedes generarla con:  openssl rand -base64 32
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
